# Copie para .env. Não execute este arquivo com source. Configure somente localmente.
WUG_URL=https://wug.example.test:9644
WUG_USERNAME=ALTERAR_LOCALMENTE
WUG_PASSWORD=ALTERAR_LOCALMENTE
# Alternativa à conta: token já obtido. Quando preenchido, dispensa username/password.
WUG_TOKEN=
WUG_VERIFY_SSL=true
WUG_CA_BUNDLE=
NETBOX_URL=https://netbox.example.test
NETBOX_TOKEN=ALTERAR_LOCALMENTE
NETBOX_VERIFY_SSL=true
NETBOX_CA_BUNDLE=
NETBOX_VLAN_GROUP_ID=
REQUEST_TIMEOUT=30
# Proxy opcional e explícito. Variáveis HTTP(S)_PROXY herdadas não são utilizadas.
HTTPS_PROXY_URL=
